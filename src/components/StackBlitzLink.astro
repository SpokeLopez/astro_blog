---
interface Props {
  href: string;
  title?: string;
}

const { href, title = 'Abrir ejemplo en StackBlitz' } = Astro.props;
---

<section class="stackblitz-link" aria-label="Ejemplo interactivo">
  <div class="stackblitz-link__icon" aria-hidden="true">⚡</div>
  <div class="stackblitz-link__content">
    <span class="stackblitz-link__eyebrow">Ejemplo interactivo</span>
    <p>Explora y modifica el código directamente en StackBlitz.</p>
  </div>
  <a href={href} target="_blank" rel="noopener noreferrer" class="stackblitz-link__button">
    {title}
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </svg>
  </a>
</section>

<style>
  .stackblitz-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-accent-muted), transparent 70%), var(--color-bg-secondary);
  }

  .stackblitz-link__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 1.35rem;
  }

  .stackblitz-link__eyebrow {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stackblitz-link__content p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .stackblitz-link__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .stackblitz-link__button:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .stackblitz-link {
      grid-template-columns: auto 1fr;
    }

    .stackblitz-link__button {
      grid-column: 1 / -1;
      width: 100%;
      margin-top: var(--space-xs);
    }
  }
</style>
