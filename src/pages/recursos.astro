---

<BaseLayout
  title="Recursos | SpokeLopez"
  description="Herramientas, extensiones y recursos que uso para desarrollo web."
>
  <div class="page-header">
    <span class="page-tag">Recursos</span>
    <h1>Herramientas y Recursos</h1>
    <p class="page-description">
      Una colección de herramientas, extensiones y recursos que uso en mi día a día como desarrollador.
    </p>
  </div>

  <!-- ─── Dev Tools Showcase ─── -->
  <section class="devtools-section">
    <div class="section-header">
      <h2 class="section-title">
        <span class="section-title-icon">🖥️</span>
        Herramientas de Desarrollo
      </h2>
      <p class="section-subtitle">Mi stack de herramientas actual — de la terminal al editor.</p>
    </div>

    <div class="devtools-groups">
      {devTools.map((group) => (
        <div class="devtools-group">
          <h3 class="group-label">
            <span class="group-icon">{group.icon}</span>
            {group.subcategory}
          </h3>
          <ul class="devtools-list">
            {group.items.map((tool) => (
              <li class="devtool-item">
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="devtool-link">
                  <div class="devtool-info">
                    <span class="devtool-name">{tool.name}</span>
                    <span class="devtool-desc">{tool.description}</span>
                  </div>
                  {tool.badge && <span class={`devtool-badge badge-${tool.badge.toLowerCase()}`}>{tool.badge}</span>}
                  <svg
                    class="devtool-arrow"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── Editor Extensions ─── -->
  <section class="devtools-section">
    <div class="section-header">
      <h2 class="section-title">
        <span class="section-title-icon">🧩</span>
        Extensiones para Editor
