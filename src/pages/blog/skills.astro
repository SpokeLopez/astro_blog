---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import '../../styles/blog-listings.css';

const postModules = import.meta.glob('./*.mdx', { eager: true });
const allPosts = Object.entries(postModules).map(([path, mod]: [string, any]) => ({ ...mod, file: path }));
const skillsPosts = allPosts
  .filter(post => 
    post.frontmatter.category === 'skills' ||
    (Array.isArray(post.frontmatter.tags) && post.frontmatter.tags.some((t: string) => t.toLowerCase() === 'skills'))
  )
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout
  title="Skills | SpokeLopez"
  description="Guías sobre skills para agentes de IA: cómo funcionan, cómo instalarlas y cómo sacarles el máximo partido en tu flujo de trabajo."
>
  <div class="blog-listing">
    <div class="page-header">
      <span class="page-tag">Skills</span>
      <h1>Skills para agentes de IA</h1>
      <p class="page-description">
        Extensiones, reglas y configuraciones que cambian cómo se comportan los agentes de IA. Desde instalación hasta resultados medibles.
      </p>
    </div>

    <div class="posts-grid">
      {skillsPosts.length > 0 ? (
        skillsPosts.map(post => (
          <PostCard
            title={post.frontmatter.title}
            description={post.frontmatter.description}
            date={new Date(post.frontmatter.date)}
            slug={post.file.split('/').pop()?.replace('.mdx', '') || ''}
            tags={post.frontmatter.tags}
            readingTime={post.frontmatter.readingTime}
          />
        ))
      ) : (
        <p class="no-posts">Aún no hay entradas en esta categoría. Las nuevas aparecerán aquí.</p>
      )}
    </div>

    <Pagination totalPosts={skillsPosts.length} />
  </div>
</BaseLayout>

<script>
  const PAGE_SIZE = 9;
  let currentPage = 0;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.posts-grid .post-card'));
  const prevBtn = document.querySelector<HTMLButtonElement>('.prev-btn');
  const nextBtn = document.querySelector<HTMLButtonElement>('.next-btn');
  const pageNums = document.querySelectorAll<HTMLButtonElement>('.page-num');
  const totalPages = Math.ceil(cards.length / PAGE_SIZE);

  function render() {
    cards.forEach((c, i) => {
      c.style.display = i >= currentPage * PAGE_SIZE && i < (currentPage + 1) * PAGE_SIZE ? '' : 'none';
    });
    prevBtn && (prevBtn.disabled = currentPage === 0);
    nextBtn && (nextBtn.disabled = currentPage >= totalPages - 1);
    pageNums.forEach((btn, i) => btn.classList.toggle('active', i === currentPage));
  }

  prevBtn?.addEventListener('click', () => { currentPage--; render(); });
  nextBtn?.addEventListener('click', () => { currentPage++; render(); });
  pageNums.forEach(btn => {
    btn.addEventListener('click', () => { currentPage = Number(btn.dataset.page); render(); });
  });

  render();
</script>
