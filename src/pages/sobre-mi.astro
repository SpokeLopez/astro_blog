---
import BaseLayout from '../layouts/BaseLayout.astro';

const CAL_PROFILE_URL = 'https://cal.com/eduardo-lopez-nmf4id';

const experience = [
  {
    period: 'dic. 2025 - Actualidad',
    duration: '4 meses',
    role: 'Desarrollador de eCommerce',
    company: 'Vivofacil',
    location: 'Comunidad de Madrid, España — En remoto',
    description:
      'Desarrollo y mantenimiento de tiendas en Prestashop, Magento y Shopify. Líder en desarrollo y mantenimiento de las mismas.',
    skills: ['Prestashop', 'Magento', 'Shopify'],
  },
  {
    period: 'abr. 2025 - nov. 2025',
    duration: '8 meses',
    role: 'Desarrollador Prestashop',
    company: 'Forte Innovation Consulting',
    location: 'Guanajuato, México — En remoto',
    description:
      'Desarrollo de módulos para Prestashop, modificación de módulos existentes y mejora del código junto al equipo del proyecto.',
    skills: ['MySQL', 'Prestashop', 'PHP'],
  },
  {
    period: 'sept. 2024 - jul. 2025',
    duration: '11 meses',
    role: 'Programador web',
    company: 'AdsProject Media',
    location: 'Guanajuato, México — En remoto',
    description:
      'Desarrollo de sitios web con WordPress y Prestashop. Soporte constante a clientes y desarrollo de proyectos nuevos desde cero.',
    skills: ['WordPress', 'Shopify', 'Prestashop', 'PHP'],
  },
  {
    period: 'may. 2023 - nov. 2025',
    duration: '2 años 7 meses',
    role: 'Ingeniero de software',
    company: 'DaCodes',
    location: 'Yucatán, México — En remoto',
    description:
      'Proyectos de gobierno, comerciales y e-commerce usando Node.js, PHP y Laravel. Gestión de ambientes con AWS: ECS, CloudWatch, CodeCommit, S3 y RDS.',
    skills: ['Laravel', 'PostgreSQL', 'Node.js', 'AWS', 'PHP'],
  },
  {
    period: 'jun. 2020 - jun. 2023',
    duration: '3 años 1 mes',
    role: 'Desarrollador de Magento',
    company: 'VASS LATAM',
    location: 'Santiago, Chile — En remoto',
    description:
      'Desarrollo frontend para proyecto de Telefónica Chile en Magento 2.2 y 2.4: flujos de compra de nuevo producto y renovación.',
    skills: ['Magento', 'JavaScript', 'Vue.js', 'CSS'],
  },
  {
    period: 'jun. 2018 - abr. 2020',
    duration: '1 año 11 meses',
    role: 'Desarrollador de Magento',
    company: 'Wolf Sellers',
    location: 'Ciudad de México, México',
    description: 'Desarrollador Frontend Magento. Adobe Commerce Gold Partner.',
    skills: ['Magento', 'PHP', 'CSS', 'JavaScript'],
  },
];

const stack = [
  { name: 'PHP', level: 95 },
  { name: 'JavaScript', level: 90 },
  { name: 'Magento', level: 85 },
  { name: 'Shopify', level: 80 },
  { name: 'SQL', level: 85 },
  { name: 'Vue.js', level: 75 },
  { name: 'Node.js', level: 80 },
  { name: 'Laravel', level: 80 },
  { name: 'CSS / Less / SASS', level: 90 },
  { name: 'Prestashop', level: 85 },
];
---

<BaseLayout
  title="Sobre mí — Eduardo López | SpokeLopez"
  description="Soy Eduardo López, desarrollador Full Stack con más de 8 años de experiencia en eCommerce. Especializado en Magento, Shopify, PHP y JavaScript. Comparto tutoriales de programación en TikTok y YouTube."
>
  <div class="sobre-mi">

    <!-- Hero -->
    <section class="sm-hero">
      <div class="sm-hero-avatar">
        <img
          src="/images/eduardo-profile.jpeg"
          alt="Foto de Eduardo López — SpokeLopez"
          width="120"
          height="120"
          loading="eager"
        />
      </div>
      <div class="sm-hero-content">
        <h1 class="sm-hero-name">Eduardo López</h1>
        <p class="sm-hero-role">Software Engineer &amp; eCommerce Developer</p>
        <p class="sm-hero-bio">
          Desarrollador Full Stack con más de <strong>8 años de experiencia</strong> construyendo soluciones web y
          e-commerce. Especializado en <strong>PHP, JavaScript, Magento, Shopify y Prestashop</strong>.
          Trabajo en remoto desde México con clientes en España y LATAM.
        </p>
        <p class="sm-hero-bio">
          Comparto tutoriales y tips de programación en
          <a href="https://tiktok.com/@spokelopez" target="_blank" rel="noopener noreferrer">TikTok</a>
          y
          <a href="https://youtube.com/@spokelopez" target="_blank" rel="noopener noreferrer">YouTube</a>.
          En este blog profundizo en Magento, Shopify, Prestashop y desarrollo web: código completo, contexto real,
          sin relleno.
        </p>
        <div class="sm-hero-actions">
          <a href={CAL_PROFILE_URL} target="_blank" rel="noopener noreferrer" class="sm-btn sm-btn-primary">
            Agendar reunión
          </a>
          <a href="mailto:elopez@comsoft-mexico.com" class="sm-btn sm-btn-outline">
            Contactar
          </a>
          <a href="/cv-eduardo-lopez.pdf" target="_blank" rel="noopener noreferrer" class="sm-btn sm-btn-outline">
            Descargar CV
          </a>
        </div>
        <div class="sm-hero-social">
          <a href="https://linkedin.com/in/spokelopez" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          <a href="https://github.com/spokelopez" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
          <a href="https://tiktok.com/@spokelopez" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
          <a href="https://youtube.com/@spokelopez" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Experiencia -->
    <section class="sm-section">
      <h2 class="sm-section-title">Experiencia</h2>
      <div class="sm-timeline">
        {experience.map((job) => (
          <div class="sm-timeline-item">
            <div class="sm-timeline-dot" aria-hidden="true"></div>
            <div class="sm-timeline-body">
              <div class="sm-job-header">
                <div>
                  <h3 class="sm-job-role">{job.role}</h3>
                  <p class="sm-job-company">{job.company} · <span class="sm-job-location">{job.location}</span></p>
                </div>
                <div class="sm-job-period">
                  <span>{job.period}</span>
                  <span class="sm-job-duration">{job.duration}</span>
                </div>
              </div>
              <p class="sm-job-description">{job.description}</p>
              <div class="sm-job-skills">
                {job.skills.map((skill) => (
                  <span class="sm-skill-tag">{skill}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Stack técnico -->
    <section class="sm-section">
      <h2 class="sm-section-title">Stack técnico</h2>
      <div class="sm-stack-grid">
        {stack.map((item) => (
          <div class="sm-stack-item">
            <div class="sm-stack-header">
              <span class="sm-stack-name">{item.name}</span>
              <span class="sm-stack-level">{item.level}%</span>
            </div>
            <div class="sm-stack-bar" role="progressbar" aria-valuenow={item.level} aria-valuemin={0} aria-valuemax={100} aria-label={`${item.name}: ${item.level}%`}>
              <div class="sm-stack-fill" style={`width: ${item.level}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="sm-cta">
      <h2 class="sm-cta-title">¿Tienes un proyecto en mente?</h2>
      <p class="sm-cta-text">
        Si necesitas un desarrollador con experiencia en eCommerce, Magento, Shopify o desarrollo web fullstack,
        estaré encantado de escucharte.
      </p>
      <div class="sm-cta-actions">
        <a href={CAL_PROFILE_URL} target="_blank" rel="noopener noreferrer" class="sm-btn sm-btn-primary">
          Agendar una llamada
        </a>
        <a href="/blog" class="sm-btn sm-btn-outline">
          Ver el blog
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .sobre-mi {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-md);
  }

  /* Hero */
  .sm-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xl);
    align-items: start;
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--color-border);
  }

  .sm-hero-avatar img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }

  .sm-hero-name {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .sm-hero-role {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .sm-hero-bio {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .sm-hero-bio a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sm-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .sm-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.5em 1.1em;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sm-btn-primary {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .sm-btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .sm-btn-outline {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .sm-btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sm-hero-social {
    display: flex;
    gap: var(--space-md);
  }

  .sm-hero-social a {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .sm-hero-social a:hover {
    color: var(--color-accent);
  }

  /* Sections */
  .sm-section {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--color-border);
  }

  .sm-section:last-of-type {
    border-bottom: none;
  }

  .sm-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-xl);
    color: var(--color-text);
  }

  /* Timeline */
  .sm-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    padding-left: var(--space-xl);
  }

  .sm-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 0;
    width: 1px;
    background-color: var(--color-border);
  }

  .sm-timeline-item {
    position: relative;
    padding-bottom: var(--space-2xl);
  }

  .sm-timeline-item:last-child {
    padding-bottom: 0;
  }

  .sm-timeline-dot {
    position: absolute;
    left: calc(-1 * var(--space-xl) + 2px);
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-bg);
    outline: 1px solid var(--color-border);
  }

  .sm-job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .sm-job-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2px;
  }

  .sm-job-company {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .sm-job-location {
    color: var(--color-text-muted);
  }

  .sm-job-period {
    text-align: right;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
  }

  .sm-job-duration {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .sm-job-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .sm-job-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .sm-skill-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2em 0.65em;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  /* Stack */
  .sm-stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-lg);
  }

  .sm-stack-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .sm-stack-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sm-stack-name {
    color: var(--color-text);
  }

  .sm-stack-level {
    color: var(--color-text-muted);
  }

  .sm-stack-bar {
    height: 6px;
    background-color: var(--color-bg-secondary);
    border-radius: 9999px;
    overflow: hidden;
  }

  .sm-stack-fill {
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 9999px;
  }

  /* CTA */
  .sm-cta {
    text-align: center;
    padding: var(--space-3xl) var(--space-xl);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .sm-cta-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .sm-cta-text {
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto var(--space-xl);
  }

  .sm-cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .sm-hero {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .sm-hero-avatar img {
      width: 90px;
      height: 90px;
    }

    .sm-hero-name {
      font-size: 1.5rem;
    }

    .sm-job-header {
      flex-direction: column;
    }

    .sm-job-period {
      text-align: left;
      flex-direction: row;
      gap: var(--space-sm);
    }
  }
</style>
